.version 7.0
.target sm_61
.address_size 64
// One block of 256 threads. Each thread visits every 256th sample.
// Input: host-prepared (normalized_time, log_y_minus_log_y0) f64 pairs.
// Output: mean_x, mean_v, centered Sxx, Sxv, Svv (five f64 values).
// Two-pass centered reduction uses EVERY measurement, including counts <256
// and counts not divisible by 256. No atomics and no cross-block race.
.visible .entry learnDecayMoments(
 .param .u64 input_ptr,
 .param .u64 output_ptr,
 .param .u32 num_samples
) {
 .reg .pred %p;
 .reg .u32 %lane,%i,%n,%step,%partner;
 .reg .u64 %in,%out,%addr,%offset,%smem,%saddr,%other;
 .reg .f64 %x,%v,%sx,%sv,%sxx,%sxv,%svv,%mx,%mv,%a,%b,%dn;
 .shared .align 8 .b8 values[10240];
 ld.param.u64 %in,[input_ptr];
 ld.param.u64 %out,[output_ptr];
 ld.param.u32 %n,[num_samples];
 mov.u32 %lane,%tid.x;
 mov.u32 %i,%lane;
 mov.f64 %sx,0d0000000000000000;
 mov.f64 %sv,0d0000000000000000;
FIRST:
 setp.ge.u32 %p,%i,%n;
 @%p bra FIRST_DONE;
 mul.wide.u32 %offset,%i,16;
 add.u64 %addr,%in,%offset;
 ld.global.f64 %x,[%addr];
 ld.global.f64 %v,[%addr+8];
 add.rn.f64 %sx,%sx,%x;
 add.rn.f64 %sv,%sv,%v;
 add.u32 %i,%i,256;
 bra FIRST;
FIRST_DONE:
 mov.u64 %smem,values;
 mul.wide.u32 %offset,%lane,8;
 add.u64 %saddr,%smem,%offset;
 st.shared.f64 [%saddr],%sx;
 st.shared.f64 [%saddr+2048],%sv;
 bar.sync 0;
 mov.u32 %step,128;
REDUCE_MEANS:
 setp.ge.u32 %p,%lane,%step;
 @%p bra MEANS_BARRIER;
 add.u32 %partner,%lane,%step;
 mul.wide.u32 %offset,%partner,8;
 add.u64 %other,%smem,%offset;
 ld.shared.f64 %a,[%saddr];
 ld.shared.f64 %b,[%other];
 add.rn.f64 %a,%a,%b;
 st.shared.f64 [%saddr],%a;
 ld.shared.f64 %a,[%saddr+2048];
 ld.shared.f64 %b,[%other+2048];
 add.rn.f64 %a,%a,%b;
 st.shared.f64 [%saddr+2048],%a;
MEANS_BARRIER:
 bar.sync 0;
 shr.u32 %step,%step,1;
 setp.ne.u32 %p,%step,0;
 @%p bra REDUCE_MEANS;
 cvt.rn.f64.u32 %dn,%n;
 ld.shared.f64 %mx,[%smem];
 ld.shared.f64 %mv,[%smem+2048];
 div.rn.f64 %mx,%mx,%dn;
 div.rn.f64 %mv,%mv,%dn;
 mov.f64 %sxx,0d0000000000000000;
 mov.f64 %sxv,0d0000000000000000;
 mov.f64 %svv,0d0000000000000000;
 mov.u32 %i,%lane;
SECOND:
 setp.ge.u32 %p,%i,%n;
 @%p bra SECOND_DONE;
 mul.wide.u32 %offset,%i,16;
 add.u64 %addr,%in,%offset;
 ld.global.f64 %x,[%addr];
 ld.global.f64 %v,[%addr+8];
 sub.rn.f64 %x,%x,%mx;
 sub.rn.f64 %v,%v,%mv;
 fma.rn.f64 %sxx,%x,%x,%sxx;
 fma.rn.f64 %sxv,%x,%v,%sxv;
 fma.rn.f64 %svv,%v,%v,%svv;
 add.u32 %i,%i,256;
 bra SECOND;
SECOND_DONE:
 st.shared.f64 [%saddr+4096],%sxx;
 st.shared.f64 [%saddr+6144],%sxv;
 st.shared.f64 [%saddr+8192],%svv;
 bar.sync 0;
 mov.u32 %step,128;
REDUCE_MOMENTS:
 setp.ge.u32 %p,%lane,%step;
 @%p bra MOMENTS_BARRIER;
 add.u32 %partner,%lane,%step;
 mul.wide.u32 %offset,%partner,8;
 add.u64 %other,%smem,%offset;
 ld.shared.f64 %a,[%saddr+4096];
 ld.shared.f64 %b,[%other+4096];
 add.rn.f64 %a,%a,%b;
 st.shared.f64 [%saddr+4096],%a;
 ld.shared.f64 %a,[%saddr+6144];
 ld.shared.f64 %b,[%other+6144];
 add.rn.f64 %a,%a,%b;
 st.shared.f64 [%saddr+6144],%a;
 ld.shared.f64 %a,[%saddr+8192];
 ld.shared.f64 %b,[%other+8192];
 add.rn.f64 %a,%a,%b;
 st.shared.f64 [%saddr+8192],%a;
MOMENTS_BARRIER:
 bar.sync 0;
 shr.u32 %step,%step,1;
 setp.ne.u32 %p,%step,0;
 @%p bra REDUCE_MOMENTS;
 setp.ne.u32 %p,%lane,0;
 @%p bra EXIT;
 st.global.f64 [%out],%mx;
 st.global.f64 [%out+8],%mv;
 ld.shared.f64 %a,[%smem+4096];
 st.global.f64 [%out+16],%a;
 ld.shared.f64 %a,[%smem+6144];
 st.global.f64 [%out+24],%a;
 ld.shared.f64 %a,[%smem+8192];
 st.global.f64 [%out+32],%a;
EXIT: ret;
}
