.version 7.0
.target sm_61
.address_size 64
// y=exp(-k*t), with f64 range reduction and an 18th-degree exp polynomial.
// Host validates 0 < k*max_t <= 700, so the power-of-two scale is normal.
// Accuracy is checked independently against Python/libm exp, including x=-700.
.visible .entry create_decay_data(
 .param .u64 p_out, .param .f64 p_k,
 .param .u32 p_num, .param .f64 p_maxt
) {
 .reg .pred %p;
 .reg .u32 %i,%n,%stride,%tmp;
 .reg .s32 %power;
 .reg .u64 %out,%addr,%offset,%bits;
 .reg .f64 %k,%maxt,%den,%t,%x,%q,%r,%y,%scale;
 ld.param.u64 %out,[p_out];
 ld.param.f64 %k,[p_k];
 ld.param.u32 %n,[p_num];
 ld.param.f64 %maxt,[p_maxt];
 mov.u32 %i,%ctaid.x;
 mov.u32 %tmp,%ntid.x;
 mul.lo.u32 %i,%i,%tmp;
 mov.u32 %tmp,%tid.x;
 add.u32 %i,%i,%tmp;
 mov.u32 %stride,%nctaid.x;
 mov.u32 %tmp,%ntid.x;
 mul.lo.u32 %stride,%stride,%tmp;
 sub.u32 %tmp,%n,1;
 cvt.rn.f64.u32 %den,%tmp;
LOOP:
 setp.ge.u32 %p,%i,%n;
 @%p bra EXIT;
 cvt.rn.f64.u32 %t,%i;
 div.rn.f64 %t,%t,%den;
 mul.rn.f64 %t,%t,%maxt;
 mul.rn.f64 %x,%k,%t;
 neg.f64 %x,%x;
 mul.rn.f64 %q,%x,0d3FF71547652B82FE;
 cvt.rni.s32.f64 %power,%q;
 cvt.rn.f64.s32 %q,%power;
 fma.rn.f64 %r,%q,0dBFE62E42FEE00000,%x;
 fma.rn.f64 %r,%q,0dBDEA39EF35793C76,%r;
 mov.f64 %y,0d3CA6827863B97D97;
 fma.rn.f64 %y,%y,%r,0d3CE952C77030AD4A;
 fma.rn.f64 %y,%y,%r,0d3D2AE7F3E733B81F;
 fma.rn.f64 %y,%y,%r,0d3D6AE7F3E733B81F;
 fma.rn.f64 %y,%y,%r,0d3DA93974A8C07C9D;
 fma.rn.f64 %y,%y,%r,0d3DE6124613A86D09;
 fma.rn.f64 %y,%y,%r,0d3E21EED8EFF8D898;
 fma.rn.f64 %y,%y,%r,0d3E5AE64567F544E4;
 fma.rn.f64 %y,%y,%r,0d3E927E4FB7789F5C;
 fma.rn.f64 %y,%y,%r,0d3EC71DE3A556C734;
 fma.rn.f64 %y,%y,%r,0d3EFA01A01A01A01A;
 fma.rn.f64 %y,%y,%r,0d3F2A01A01A01A01A;
 fma.rn.f64 %y,%y,%r,0d3F56C16C16C16C17;
 fma.rn.f64 %y,%y,%r,0d3F81111111111111;
 fma.rn.f64 %y,%y,%r,0d3FA5555555555555;
 fma.rn.f64 %y,%y,%r,0d3FC5555555555555;
 fma.rn.f64 %y,%y,%r,0d3FE0000000000000;
 fma.rn.f64 %y,%y,%r,0d3FF0000000000000;
 fma.rn.f64 %y,%y,%r,0d3FF0000000000000;
 add.s32 %power,%power,1023;
 cvt.u64.u32 %bits,%power;
 shl.b64 %bits,%bits,52;
 mov.b64 %scale,%bits;
 mul.rn.f64 %y,%y,%scale;
 mul.wide.u32 %offset,%i,16;
 add.u64 %addr,%out,%offset;
 st.global.f64 [%addr],%t;
 st.global.f64 [%addr+8],%y;
 add.u32 %i,%i,%stride;
 bra LOOP;
EXIT: ret;
}
